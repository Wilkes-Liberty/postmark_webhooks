<?php

/**
 * @file
 * Install and schema hooks for the Postmark Webhooks module.
 */

use Drupal\postmark_webhooks\Suppression\SuppressionStore;
use Drupal\Core\Database\SchemaObjectExistsException;

/**
 * Implements hook_schema().
 */
function postmark_webhooks_schema() {
  $schema['postmark_events'] = [
    'description' => 'Log of Postmark bounce, spam, and delivery webhook events.',
    'fields' => [
      'occurred' => [
        'type' => 'int',
        'size' => 'big',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Provider occurrence time; legacy rows use receipt time.',
      ],
      'time_basis' => [
        'type' => 'varchar',
        'length' => 8,
        'not null' => TRUE,
        'default' => 'legacy',
        'description' => 'provider, receipt, or legacy.',
      ],
      'server_id' => [
        'type' => 'varchar',
        'length' => 20,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Provider server identifier when supplied.',
      ],
      'message_stream' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Provider message stream when supplied.',
      ],
      'event_key' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
        'description' => 'Versioned event identity digest; NULL for legacy events.',
      ],
      'eid' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Event ID.',
      ],
      'created' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Unix timestamp when received.',
      ],
      'event_type' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Postmark RecordType (e.g. Bounce, SpamComplaint, Delivery).',
      ],
      'message_id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Postmark MessageID.',
      ],
      'recipient' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Recipient email address.',
      ],
      'bounce_type' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Bounce Type (HardBounce, SoftBounce, etc.) if applicable.',
      ],
      'description' => [
        'type' => 'varchar',
        'length' => 512,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Human-readable description from Postmark.',
      ],
      'payload' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
        'description' => 'Reserved legacy payload column; new events always store NULL.',
      ],
    ],
    'primary key' => ['eid'],
    'unique keys' => ['event_key' => ['event_key']],
    'indexes' => [
      'created'    => ['created'],
      'event_type' => ['event_type'],
      'recipient'  => ['recipient'],
      'message_id' => ['message_id'],
    ],
  ];
  $schema['postmark_suppression'] = [
    'description' => 'Minimal suppression evidence, independent of event retention.',
    'fields' => [
      'state_key' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'recipient' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'server_id' => ['type' => 'varchar', 'length' => 20, 'not null' => TRUE, 'default' => ''],
      'message_stream' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
      'reason' => ['type' => 'varchar', 'length' => 80, 'not null' => TRUE],
      'occurred' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
      'time_basis' => ['type' => 'varchar', 'length' => 8, 'not null' => TRUE],
      'evidence' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
    ],
    'primary key' => ['state_key'],
    'indexes' => ['recipient' => ['recipient']],
  ];
  return $schema;
}

/**
 * Adds atomic event identity while preserving all legacy event evidence.
 */
function postmark_webhooks_update_10001(): void {
  $schema = \Drupal::database()->schema();
  $field = [
    'type' => 'varchar',
    'length' => 64,
    'not null' => FALSE,
    'description' => 'Versioned event identity digest; NULL for legacy events.',
  ];
  if (!$schema->fieldExists('postmark_events', 'event_key')) {
    $schema->addField('postmark_events', 'event_key', $field);
  }
  try {
    $schema->addUniqueKey('postmark_events', 'event_key', ['event_key']);
  }
  catch (SchemaObjectExistsException $exception) {
    // The driver checks its own unique-key representation on resumed updates.
  }
}

/**
 * Migrates retained alpha evidence into durable state in bounded batches.
 */
function postmark_webhooks_update_10002(array &$sandbox): void {
  $database = \Drupal::database();
  $schema = $database->schema();
  // Keep this migration independent of future hook_schema() changes.
  $definition = [
    'postmark_events' => [
      'fields' => [
        'occurred' => [
          'type' => 'int',
          'size' => 'big',
          'not null' => TRUE,
          'default' => 0,
          'description' => 'Provider occurrence time; legacy rows use receipt time.',
        ],
        'time_basis' => [
          'type' => 'varchar',
          'length' => 8,
          'not null' => TRUE,
          'default' => 'legacy',
          'description' => 'provider, receipt, or legacy.',
        ],
        'server_id' => [
          'type' => 'varchar',
          'length' => 20,
          'not null' => TRUE,
          'default' => '',
          'description' => 'Provider server identifier when supplied.',
        ],
        'message_stream' => [
          'type' => 'varchar',
          'length' => 255,
          'not null' => TRUE,
          'default' => '',
          'description' => 'Provider message stream when supplied.',
        ],
      ],
    ],
    'postmark_suppression' => [
      'description' => 'Minimal suppression evidence, independent of event retention.',
      'fields' => [
        'state_key' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
        'recipient' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
        'server_id' => ['type' => 'varchar', 'length' => 20, 'not null' => TRUE, 'default' => ''],
        'message_stream' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
        'reason' => ['type' => 'varchar', 'length' => 80, 'not null' => TRUE],
        'occurred' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
        'time_basis' => ['type' => 'varchar', 'length' => 8, 'not null' => TRUE],
        'evidence' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      ],
      'primary key' => ['state_key'],
      'indexes' => ['recipient' => ['recipient']],
    ],
  ];
  if (!isset($sandbox['last_eid'])) {
    foreach (['occurred', 'time_basis', 'server_id', 'message_stream'] as $field) {
      if (!$schema->fieldExists('postmark_events', $field)) {
        $schema->addField('postmark_events', $field, $definition['postmark_events']['fields'][$field]);
      }
    }
    if (!$schema->tableExists('postmark_suppression')) {
      $schema->createTable('postmark_suppression', $definition['postmark_suppression']);
    }
    $sandbox['last_eid'] = 0;
  }
  $query = $database->select('postmark_events', 'pe')->fields('pe')
    ->condition('eid', $sandbox['last_eid'], '>')->orderBy('eid')->range(0, 250);
  $events = $query->execute()->fetchAll();
  $store = new SuppressionStore($database);
  foreach ($events as $event) {
    $store->record((array) $event);
    $sandbox['last_eid'] = (int) $event->eid;
  }
  $sandbox['#finished'] = count($events) < 250 ? 1 : 0.5;
}
