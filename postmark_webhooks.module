<?php

/**
 * @file
 * Hook implementations for the Postmark Webhooks module.
 */

/**
 * Implements hook_mail_alter().
 *
 * Blocks outbound email to addresses that have previously bounced hard or
 * filed a spam complaint. Soft/transient bounces suppress for a configurable
 * window; hard bounces and spam complaints suppress permanently (or per the
 * complaint_suppression_days setting).
 */
function postmark_webhooks_mail_alter(array &$message): void {
  $config = \Drupal::config('postmark_webhooks.settings');
  if (!$config->get('enabled')) {
    return;
  }

  $to = trim($message['to'] ?? '');
  if ($to === '') {
    return;
  }

  // Strip display name if present: "Name <email>" → "email".
  if (preg_match('/<([^>]+)>/', $to, $m)) {
    $to = $m[1];
  }

  $reason = _postmark_webhooks_suppression_reason($to, $config);
  if ($reason !== NULL) {
    $message['send'] = FALSE;
    \Drupal::logger('postmark_webhooks')->info(
      'Suppressed outbound email to %to: %reason',
      ['%to' => _postmark_webhooks_redact_recipient($to), '%reason' => $reason]
    );
  }
}

/**
 * Implements hook_cron().
 *
 * Drops Postmark event rows older than the configured retention window
 * (90 days in install config). 0 disables purge.
 */
function postmark_webhooks_cron(): void {
  $days = (int) (\Drupal::config('postmark_webhooks.settings')->get('event_retention_days') ?? 90);
  if ($days <= 0) {
    return;
  }
  $cutoff = \Drupal::time()->getRequestTime() - ($days * 86400);
  \Drupal::database()->delete('postmark_events')
    ->condition('created', $cutoff, '<')
    ->execute();
}

/**
 * Redacts a recipient to domain-only so suppression logs hold no mailbox.
 */
function _postmark_webhooks_redact_recipient(string $email): string {
  $email = trim($email);
  $at = strrpos($email, '@');
  if ($at === FALSE || $at === strlen($email) - 1) {
    return '[redacted]';
  }
  return '*@' . substr($email, $at + 1);
}

/**
 * Returns a suppression reason, or NULL if not suppressed.
 *
 * Bounce type classification:
 *   Permanent (no window): HardBounce, BadEmailAddress, ManuallyDeactivated,
 *     Unsubscribe, SpamComplaint, SpamNotification
 *   Temporary: Transient, SoftBounce, DnsError,
 *     MailboxFull, MessageTooLarge
 *   Log-only (no suppression): Delivery, Open, Click, Subscribe, and unknowns.
 *
 * Compatibility wrapper around the shared effective-decision service.
 * Recipients are normalized before indexed durable-state lookup.
 */
function _postmark_webhooks_suppression_reason(string $email, $config): ?string {
  $decision = \Drupal::service('postmark_webhooks.suppression_policy')->decide($email);
  if (!$decision->suppressed) {
    return NULL;
  }
  [$kind, $type] = explode(':', $decision->reason, 2);
  $label = ['spam' => 'spam complaint', 'hard' => 'hard bounce', 'soft' => 'soft bounce'][$kind];
  return $label . ' (' . $type . ') on ' . date('Y-m-d', $decision->occurred);
}
